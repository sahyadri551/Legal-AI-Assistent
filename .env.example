# Copy to .env and adjust locally. Do not commit .env.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Streamlit
STREAMLIT_SERVER_PORT=8501

# Ollama (Qwen3 4B Instruct). Model must already be available locally.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Embeddings run on CPU in this project.
EMBEDDING_DEVICE=cpu
HF_HOME=.cache/huggingface
