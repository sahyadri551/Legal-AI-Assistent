APP_ENV=development
LOG_LEVEL=INFO

# Local API
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DOCUMENT_MAX_MB=15

# Groq generation
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# CPU embeddings
EMBEDDING_DEVICE=cpu
HF_HOME=.cache/huggingface
