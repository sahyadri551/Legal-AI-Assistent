# Copy to .env and adjust locally. Do not commit .env.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Streamlit
STREAMLIT_SERVER_PORT=8501

# Groq generation
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Embeddings run on CPU in this project.
EMBEDDING_DEVICE=cpu
HF_HOME=.cache/huggingface
